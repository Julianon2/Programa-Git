      "item": [
        {
          "name": "CP-01 Consultar todos los productos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "pm.test(\"Tiempo de respuesta < 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        },
